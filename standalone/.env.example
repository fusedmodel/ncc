# NCC Registry · Standalone 部署环境变量示例
# 复制为 .env 后按需修改，docker-compose 会自动读取。

# ---- 服务 ----
NCC_PORT=8181
NCC_PUBLIC_BASE=http://localhost:8181
NCC_DATA_DIR=/data

# ---- 存储驱动：local（本地磁盘，默认）| s3（S3 兼容对象存储）----
NCC_STORAGE_DRIVER=s3

# ---- S3 兼容对象存储（Ceph RGW / MinIO / AWS S3）----
NCC_S3_ENDPOINT=http://minio:9000
NCC_S3_REGION=us-east-1
NCC_S3_ACCESS_KEY=nccadmin
NCC_S3_SECRET_KEY=nccadmin123
NCC_S3_BUCKET=ncc
# 公开访问基址（公开条目下载 URL）；留空则用 endpoint/bucket
NCC_S3_PUBLIC_BASE=http://localhost:9000/ncc

# ---- 付费（未配置 Stripe 时为演示直充）----
# NCC_STRIPE_SECRET_KEY=
# NCC_STRIPE_PUBLISHABLE_KEY=
# NCC_STRIPE_WEBHOOK_SECRET=
# NCC_STRIPE_PRO_PRICE=price_pro

# ---- OAuth 第三方登录（redirect_uri = NCC_PUBLIC_BASE/api/auth/oauth/<provider>/callback）----
# NCC_GOOGLE_CLIENT_ID=
# NCC_GOOGLE_CLIENT_SECRET=
# NCC_GITHUB_CLIENT_ID=
# NCC_GITHUB_CLIENT_SECRET=
