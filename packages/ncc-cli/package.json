{
  "name": "@fusedmodel/ncc-cli",
  "version": "0.1.0",
  "description": "npm wrapper for the NCC CLI: locates (or downloads) the platform Rust binary and runs it.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fusedmodel/ncc.git",
    "directory": "packages/ncc-cli"
  },
  "homepage": "https://ncc.ai/cli",
  "bugs": {
    "url": "https://github.com/fusedmodel/ncc/issues"
  },
  "keywords": [
    "ncc",
    "registry",
    "capability",
    "mcp",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ncc": "bin/ncc.js"
  },
  "scripts": {
    "postinstall": "node bin/install.js"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
